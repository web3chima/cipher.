# ─────────────────────────────────────────────────────────────────────────────
# Cipher Backend — server/.env.example
# Copy to server/.env and fill in values. Never commit server/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── FVM / Filecoin ────────────────────────────────────────────────────────────
# Target network: "calibration" (default testnet) or "mainnet"
NETWORK=calibration

# RPC endpoints (defaults shown — override if using a private node)
FVM_CALIBRATION_RPC=https://api.calibration.node.glif.io/rpc/v1
FVM_MAINNET_RPC=https://api.node.glif.io/rpc/v1

# Deployed contract addresses — filled after running deploy scripts
CIPHER_REGISTRY_ADDRESS=0xEdd7aa9943cdb9335EeE530DE4523E0a5221C1C9
GROTH16_VERIFIER_ADDRESS=

# Robot wallet — signs submitProof txs (keep secret, never commit)
# Fund with tFIL: https://faucet.calibration.fildev.network/
DEPLOYER_PRIVATE_KEY=

# ── Device identity ───────────────────────────────────────────────────────────
# Unique identifier for the robot device (used as a ZK public signal)
CIPHER_DEVICE_ID=robot-001

# ── Lit Protocol (optional — leave disabled for local dev) ────────────────────
# Set to true to enable Lit-protected key management in production
LIT_KEY_MANAGER_ENABLED=false

# Robot PKP — filled after running npm run lit:mint-pkp
PKP_ETH_ADDRESS=
PKP_TOKEN_ID=

# Lit Action CIDs — filled after npm run lit:deploy-actions
LIT_SUBMIT_ACTION_CID=QmbbHhvM66VhqKPuVcwL9EaiiEKBwyEew6oqYYz7J5r5C3

# ── License keys ──────────────────────────────────────────────────────────────
# Comma-separated CIPHER-XXXX-XXXX-XXXX keys
# New keys are auto-appended at runtime when a purchase is verified
CIPHER_LICENSE_KEYS=CIPHER-ADMN-0000-TEST

# CipherLicensePayment contract — deploy via Remix, then paste address here
CIPHER_LICENSE_PAYMENT_ADDRESS=0xB5F398bC08fF65f6F4F1E352578F97c4718f6F3f
# Your wallet address (owner — can call withdraw())
CIPHER_PAYMENT_OWNER=
# License price in attoFIL (0.1 FIL = 100000000000000000)
CIPHER_LICENSE_PRICE_ATTOFIL=100000000000000000

# ── Telegram MTProto (GramJS) — get from https://my.telegram.org/apps ─────────
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Run `npm run auth` once to generate this session string
TELEGRAM_STRING_SESSION=

# Telegram Bot — get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_USERNAME=ciphersupport_bot

# Your Telegram user ID (added to each new group as admin)
CIPHER_ADMIN_USER_ID=
