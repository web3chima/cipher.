# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Telegram MTProto (GramJS) — get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Run `npm run auth` once to generate this session string
TELEGRAM_STRING_SESSION=

# Telegram Bot — get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_USERNAME=ciphersupport_bot

# Your Telegram user ID (added to each new group as admin)
CIPHER_ADMIN_USER_ID=
