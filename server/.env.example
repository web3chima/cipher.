# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# License keys (comma-separated, format: CIPHER-XXXX-XXXX-XXXX)
# New keys are auto-appended at runtime when a purchase is verified
CIPHER_LICENSE_KEYS=CIPHER-XXXX-XXXX-XXXX,CIPHER-YYYY-YYYY-YYYY

# CipherLicensePayment contract — deploy via Remix, then paste address here
CIPHER_LICENSE_PAYMENT_ADDRESS=
# Your wallet address (owner of the payment contract — can call withdraw())
CIPHER_PAYMENT_OWNER=
# License price in attoFIL shown in the UI (1 FIL = 1000000000000000000)
CIPHER_LICENSE_PRICE_ATTOFIL=100000000000000000

# Telegram MTProto (GramJS) — get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Run `npm run auth` once to generate this session string
TELEGRAM_STRING_SESSION=

# Telegram Bot — get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_USERNAME=ciphersupport_bot

# Your Telegram user ID (added to each new group as admin)
CIPHER_ADMIN_USER_ID=
